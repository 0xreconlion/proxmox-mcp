[Unit]
Description=NodeOps private owner console
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=nodeops
Group=nodeops
WorkingDirectory=/opt/nodeops-mcp
EnvironmentFile=/etc/nodeops-mcp/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nodeops-mcp/.venv/bin/nodeops-console --host 127.0.0.1 --port 8421
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nodeops-mcp /var/log/nodeops-mcp
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost
# [EDIT-REQUIRED] Replace with YOUR Proxmox host address, then uncomment.
# Left commented deliberately: with IPAddressDeny=any above, the service
# cannot reach Proxmox until you set this, which fails loudly rather than
# silently inheriting someone else's network.
# IPAddressAllow=203.0.113.10
MemoryMax=256M
CPUQuota=25%
TasksMax=32
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
