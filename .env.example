# ---------------------------------------------------------------------------
# Example configuration. Copy to `.env` and work through the markers:
#
#     cp .env.example .env
#     grep -n 'EDIT-REQUIRED' .env     # must change these, or the server won't start
#     grep -n 'EDIT-OPTIONAL' .env     # sane defaults, review if you care
#
# Every [EDIT-REQUIRED] line fails closed: the server refuses to boot rather
# than guess a value for you. That is deliberate.
#
# Don't hand-write the allowlists. Let discovery propose them from your own
# Proxmox, then trim what you don't want exposed:
#
#     uv run proxmox-mcp discover \
#       --base-url https://proxmox.example.invalid \
#       --token-id 'user@pam!tokenname' \
#       --token-secret-file /run/secrets/nodeops-proxmox-token-secret \
#       --ca-file /run/secrets/proxmox-ca.pem
#
# Then check your work before starting the server. This validates everything
# below and prints what the server will be permitted to read:
#
#     set -a && . ./.env && set +a && uv run proxmox-mcp check
# ---------------------------------------------------------------------------

NODEOPS_ENV=development

# [EDIT-OPTIONAL] Free-form version string reported by /health. Cosmetic.
NODEOPS_DEPLOYMENT_VERSION=0.1.0

# --- Proxmox backend -------------------------------------------------------

# [EDIT-REQUIRED] Your Proxmox origin. HTTPS, no trailing path.
NODEOPS_PROXMOX_BASE_URL=https://proxmox.example.invalid

# [EDIT-REQUIRED] Comma-separated Proxmox node names this server may read.
# Anything not listed here is refused by the authorization layer.
NODEOPS_PROXMOX_NODE_ALLOWLIST=example-node

# [EDIT-REQUIRED] Comma-separated `kind:id` guests, e.g. qemu:110,lxc:200.
# Must be non-empty — an empty allowlist is rejected, not treated as "all".
NODEOPS_PROXMOX_GUEST_ALLOWLIST=qemu:110

# [EDIT-REQUIRED] Comma-separated storage IDs, e.g. local,nas-backups.
# Must be non-empty — same fail-closed rule as the guest allowlist.
NODEOPS_PROXMOX_STORAGE_ALLOWLIST=local

# --- Proxmox credentials ---------------------------------------------------
# These are read from files, never from the environment directly, so the
# secrets never appear in `systemctl show`, `/proc`, or a process listing.

# [EDIT-REQUIRED] File holding `user@realm!tokenname`.
NODEOPS_PROXMOX_TOKEN_ID_FILE=/run/secrets/nodeops-proxmox-token-id

# [EDIT-REQUIRED] File holding the token secret. Mode 600.
NODEOPS_PROXMOX_TOKEN_SECRET_FILE=/run/secrets/nodeops-proxmox-token-secret

# [EDIT-REQUIRED] CA bundle that verifies your Proxmox certificate.
# TLS verification is mandatory and cannot be disabled by configuration.
NODEOPS_PROXMOX_CA_FILE=/run/secrets/proxmox-ca.pem

# --- HTTP transport --------------------------------------------------------

# [EDIT-OPTIONAL] Loopback by default. Do not bind this to a LAN address
# unless you have put authenticated TLS in front of it.
NODEOPS_HTTP_HOST=127.0.0.1
NODEOPS_HTTP_PORT=8000
NODEOPS_HTTP_PATH=/mcp

# --- Limits ----------------------------------------------------------------
# All four must be positive. Zero is rejected on purpose: an unbounded
# request, response, or timeout budget is not a valid configuration.

# [EDIT-OPTIONAL] Max inbound request body, bytes. 64 KiB.
NODEOPS_MAX_REQUEST_BYTES=65536

# [EDIT-OPTIONAL] Max backend response read, bytes. 1 MiB.
NODEOPS_MAX_RESPONSE_BYTES=1048576

# [EDIT-OPTIONAL] Backend connect timeout, seconds. Must be > 0.
NODEOPS_CONNECT_TIMEOUT_SECONDS=5

# [EDIT-OPTIONAL] Backend read timeout, seconds. Must be > 0.
NODEOPS_READ_TIMEOUT_SECONDS=20

# [EDIT-OPTIONAL] How long audit events are retained, days.
NODEOPS_AUDIT_RETENTION_DAYS=90

# --- Client authentication -------------------------------------------------

# [EDIT-OPTIONAL] `static-bearer` is the supported mode.
NODEOPS_AUTH_MODE=static-bearer

# [EDIT-REQUIRED] File holding the bearer token your MCP client presents.
# Generate one with: openssl rand -hex 32
NODEOPS_CLIENT_TOKEN_FILE=/run/secrets/nodeops-client-token

# [EDIT-REQUIRED] Public URL this server is reached at. Tokens are bound to
# this resource, and Host/Origin are validated against the two values below,
# so a copy-paste mismatch here shows up as a 403 rather than a silent pass.
NODEOPS_AUTH_ISSUER_URL=https://nodeops.example.invalid
NODEOPS_RESOURCE_SERVER_URL=https://nodeops.example.invalid/mcp

# [EDIT-OPTIONAL] Client identity and the scope it must carry.
NODEOPS_CLIENT_ID=approved-owner-client
NODEOPS_REQUIRED_SCOPE=nodeops:read

# [EDIT-REQUIRED] Exact Host and Origin values accepted. No wildcards.
NODEOPS_ALLOWED_HOSTS=nodeops.example.invalid:8443
NODEOPS_ALLOWED_ORIGINS=https://nodeops.example.invalid:8443
